{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Card",
  "description": "Объект карты Card Management Service (из спецификации api-spec.md, раздел Card)",
  "type": "object",
  "required": [
    "id", "pan", "bin", "cardholderName", "expiryDate", "status",
    "currencyCode", "dailyLimit", "monthlyLimit", "availableBalance",
    "issuerId", "createdAt"
  ],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "pan": { "type": "string", "pattern": "^\\d{16}$" },
    "bin": { "type": "string", "pattern": "^\\d{6}$" },
    "cardholderName": { "type": "string" },
    "expiryDate": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["ACTIVE", "INACTIVE", "BLOCKED", "EXPIRED"]
    },
    "currencyCode": { "type": "string" },
    "dailyLimit": { "type": "number", "minimum": 0 },
    "monthlyLimit": { "type": "number", "minimum": 0 },
    "availableBalance": { "type": "number" },
    "issuerId": { "type": "string" },
    "createdAt": { "type": "string" }
  },
  "additionalProperties": true
}